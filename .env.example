# URL API layanan (opsional). Jika tidak diisi, nilai default di src/config/api.ts dipakai.
# Ini BUKAN secret. Jangan pernah menyimpan token, secret, atau credential di file ini.
VITE_API_BASE_URL=https://am-premium-nimzz.vercel.app

# Bot Telegram untuk menerima bukti transfer donasi (halaman /donasi).
# Ini SECRET — hanya diset di dashboard Vercel (Environment Variables), JANGAN commit nilai aslinya.
# Sengaja TANPA prefix VITE_ supaya tidak ikut ter-bundle ke client.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
